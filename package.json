{
  "name": "aibuildingapp",
  "version": "0.12.3",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "test": "bun test",
    "crew": "bun run apps/cli/src/main.ts",
    "ui": "bun run apps/web/src/server.ts",
    "serve": "bun run apps/web/src/server.ts",
    "desktop": "bun run --cwd apps/desktop dev",
    "desktop:build": "bun run scripts/build-desktop.ts"
  }
}
